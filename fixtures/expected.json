{
  "specId": "in-passport",
  "about": "Real photos of the owner, taken with an iPhone (24 MP HEIC) and a laptop webcam. Each is evaluated on its own (v1 imports one photo at a time).",
  "howToAssert": [
    "expect=accept: pipeline produces output; every output bound holds; only allowedWarnings may be warn.",
    "expect=reject: input gate fails; at least one of primaryReasons (or alsoAcceptableReasons) is among the failed CheckIDs; no output is rendered.",
    "expect=borderline: must not crash; log the verdict and checks to docs/PROGRESS.md.",
    "pythonReference values come from dlib landmarks and are for diagnosis only. Do not assert Vision measurements against them."
  ],
  "checkIdVocabulary": [
    "faceCount",
    "resolution",
    "sharpness",
    "lighting",
    "yaw",
    "pitch",
    "roll",
    "eyesOpen",
    "mouthClosed",
    "dimensions",
    "fileSize",
    "headHeight",
    "topMargin",
    "eyeLine",
    "centering",
    "background",
    "faceIntegrity",
    "shouldersVisible"
  ],
