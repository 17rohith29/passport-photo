# Owner's face photos: keep local, never push
fixtures/photos/
# The finished passport photo is the owner's face too, and an identity-document
# one at that. M4 compares against it on disk; it never needs to be in history.
fixtures/reference_output/
# Exception, decided deliberately: docs/store holds one device screenshot of the owner's face
# and the App Store slide built from it. Those are destined for a public App Store listing, so
# a private repo is less exposure than their intended use, and the marketing set has to be
# reproducible from the repo. No other face photo belongs in history.
# Xcode
DerivedData/
*.xcuserstate
xcuserdata/
.build/
.swiftpm/
# debug output
/tmp/
# Third-party faces used only to calibrate thresholds. Permissively licensed, but they are
# still real people's faces, so they stay local like the owner's own photos.
fixtures/calibration/
# macOS Finder junk
.DS_Store
**/.DS_Store
# Stray npm scaffolding: this is a Swift project and has no Node dependencies.
node_modules/
package.json
package-lock.json
# The device result screenshot and the slide built from it are the owner's face. The App Store
# listing is a place they control; a public git history is not. Capture locally, upload direct.
docs/store/screenshots/6-result.png
docs/store/marketing/02-result.png
